---
import { Image } from 'astro:assets';

// Import all JPG files from the gallery folder
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/gallery/*.{jpg,jpeg,png,gif}',
  { eager: true }
);

// Convert to array
const galleryImages = Object.entries(images).map(([path, module]) => ({
  path,
  image: module.default
}));
---


<div class="photo-viewer" tabindex="0">
  <div class="photo-frame">
    {galleryImages.map(({ path, image }, index) => (
      <Image
        src={image}
        alt={path.split("/").pop() || "Gallery image"}
        width={1200}
        class="viewer-image"
        hidden={index !== 0}
      />
    ))}
  </div>

  <div class="viewer-controls">
    <button type="button" class="previous" aria-label="Previous image">
      ← Previous
    </button>

    <span class="photo-count">
      <span class="current-photo">1</span> / {galleryImages.length}
    </span>

    <button type="button" class="next" aria-label="Next image">
      Next →
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".photo-viewer").forEach((viewer) => {
    const images = Array.from(
      viewer.querySelectorAll<HTMLElement>(".viewer-image")
    );
    const previous = viewer.querySelector<HTMLButtonElement>(".previous");
    const next = viewer.querySelector<HTMLButtonElement>(".next");
    const counter = viewer.querySelector<HTMLElement>(".current-photo");

    let current = 0;

    function showImage(index: number) {
      current = (index + images.length) % images.length;

      images.forEach((image, imageIndex) => {
        image.hidden = imageIndex !== current;
      });

      if (counter) counter.textContent = String(current + 1);
    }

    previous?.addEventListener("click", () => showImage(current - 1));
    next?.addEventListener("click", () => showImage(current + 1));

    viewer.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") showImage(current - 1);
      if (event.key === "ArrowRight") showImage(current + 1);
    });
  });
</script>

<style>
  .photo-viewer {
    max-width: 1500px;
    margin: 2rem auto;
  }

  .photo-frame {
    display: grid;
    place-items: center;
    min-height: 60vh;
    background: #f1f5f9;
  }

  .viewer-image {
    width: 100%;
    max-height: 80vh;
    object-fit: contain;
  }

  .viewer-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
  }

  button {
    padding: 0.55rem 0.9rem;
    cursor: pointer;
  }
</style>